<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="underwater_world">
    <physics type="ode" name="underwater_physics">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>
    
    

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <scene>
      <!-- Ambient light -->
      <ambient>0.1 0.2 0.4 1</ambient>

      <!-- Light reflected by objects -->
      <background>0.0 0.1 0.3 1</background>

      <!-- Sky color -->
      <sky>
        <ambient>0.1 0.2 0.4 1</ambient>
      </sky>

      <!-- Underwater haze -->
      <fog>
        <color>0.0 0.2 0.4 1</color>
        <type>linear</type>
        <start>5</start>
        <end>80</end>
      </fog>
    </scene>

    <model name="water_surface">

      <static>true</static>

      <pose>0 0 0 0 0 0</pose>

      <link name="surface">

        <visual name="surface_visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.10 0.35 0.60 0.35</ambient>
            <diffuse>0.10 0.35 0.60 0.35</diffuse>
          </material>

        </visual>

      </link>

    </model>
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="terrain">


        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file://heightmaps/seabeds.png</uri>
              <size>200 200 20</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>file://heightmaps/seabeds.png</uri>
              <size>200 200 20</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>

          <material>
            <ambient>0.65 0.60 0.45 1</ambient>
            <diffuse>0.75 0.70 0.50 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>